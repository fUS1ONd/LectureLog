# Docker image channel: dev, latest или конкретный релиз vX.Y.Z.
LECTURELOG_CORE_IMAGE_TAG=dev

# Локальные порты на VPS. Наружу их должен публиковать reverse proxy.
CORE_HTTP_PORT=8000
CORE_MINIO_PORT=9000
CORE_MINIO_CONSOLE_PORT=9001

# Пароль Postgres ядра. Заполните на сервере: openssl rand -hex 24
CORE_POSTGRES_PASSWORD=

# Ключи внешних сервисов. Для STT обязателен только ключ выбранного провайдера.
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEYS=
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ru
DEEPGRAM_UTT_SPLIT=0.8
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_MODELS_SPLIT=google/gemini-3.5-flash,google/gemini-3-flash-preview
LLM_MODELS_SUBSPLIT=google/gemini-3.5-flash,google/gemini-3-flash-preview
LLM_MODELS_RENDER=google/gemini-3.1-flash-lite,google/gemini-3.5-flash,google/gemini-3-flash-preview
LLM_CONCURRENCY_SUBSPLIT=2
LLM_CONCURRENCY_RENDER=5
LLM_EFFORT_SPLIT=medium
LLM_EFFORT_SUBSPLIT=medium
LLM_EFFORT_RENDER=medium

FRAMES_ENABLED=true
LLM_MODELS_VIDEO_SLIDES=google/gemini-3.1-flash-lite,google/gemini-3.5-flash,google/gemini-3-flash-preview
LLM_EFFORT_VIDEO_SLIDES=medium
LLM_MODELS_FRAMES_CLASSIFY=google/gemini-3.5-flash,google/gemini-3-flash-preview,google/gemini-3.1-flash-lite
LLM_EFFORT_FRAMES_CLASSIFY=high

# S3/MinIO. S3_PUBLIC_ENDPOINT должен быть доступен браузеру.
S3_PUBLIC_ENDPOINT=https://files.example.com
S3_BUCKET=lectures
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PRESIGN_EXPIRY=3600

MAX_CONCURRENT_TASKS=2

# URL web-платформы для вебхука ядра. Это не Google OAuth callback.
PLATFORM_CALLBACK_URL=https://app.example.com/webhooks/core

# Общий HMAC-секрет с lecturelog-web. Заполните одинаковым значением в web и core.
LECTURELOG_WEBHOOK_SECRET=
