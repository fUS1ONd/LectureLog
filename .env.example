# Ключи внешних сервисов
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEYS=
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ru
DEEPGRAM_DETECT_LANGUAGE=false
DEEPGRAM_UTT_SPLIT=0.8
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Модели LLM через OpenRouter (приоритетный список, fallback при 429)
LLM_MODELS_SPLIT=google/gemini-3.5-flash,google/gemini-3-flash-preview
LLM_MODELS_SUBSPLIT=google/gemini-3.5-flash,google/gemini-3-flash-preview
LLM_MODELS_RENDER=google/gemini-3.1-flash-lite,google/gemini-3.5-flash,google/gemini-3-flash-preview

# Параллельность и reasoning effort по этапам структуризации
LLM_CONCURRENCY_SUBSPLIT=2
LLM_CONCURRENCY_RENDER=5
LLM_EFFORT_SPLIT=medium
LLM_EFFORT_SUBSPLIT=medium
LLM_EFFORT_RENDER=medium

# Стадия отбора кадров из видео (video_slides): отдельно от документных слайдов,
# запускается только для видео без приложенного slides-документа и без no_slides
FRAMES_ENABLED=true
# QC кадров: дешёвый список, так как вызовов больше.
LLM_MODELS_VIDEO_SLIDES=google/gemini-3.1-flash-lite,google/gemini-3.5-flash,google/gemini-3-flash-preview
LLM_EFFORT_VIDEO_SLIDES=medium
# Классификация режимов: 1-2 вызова на лекцию, поэтому можно ставить модель тяжелее.
LLM_MODELS_FRAMES_CLASSIFY=google/gemini-3.5-flash,google/gemini-3-flash-preview,google/gemini-3.1-flash-lite
LLM_EFFORT_FRAMES_CLASSIFY=high

# База данных
CORE_POSTGRES_PASSWORD=
# Пример для запуска вне Docker Compose:
# DATABASE_URL=postgresql+asyncpg://lecturelog:<CORE_POSTGRES_PASSWORD>@localhost:5432/lecturelog
DATABASE_URL=

# Хранилище лекций (S3/MinIO): исходники в uploads/, результаты в results/
# internal — endpoint движка внутри docker-сети
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_BUCKET=lectures
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PRESIGN_EXPIRY=3600
# public (опционально): хост для presigned-ссылок наружу (PUT-загрузка/GET-скачка).
# Без него presigned не выдаётся (эндпоинты /uploads и /result-url отдают 409),
# работает только стрим GET /result — безопасный дефолт автономии.
# S3_PUBLIC_ENDPOINT=https://files.example

# Воркер
MAX_CONCURRENT_TASKS=2

# Вебхук на терминальные события (опционально; без URL движок работает автономно)
# PLATFORM_CALLBACK_URL=https://platform.example/lecturelog/callback
# LECTURELOG_WEBHOOK_SECRET=
